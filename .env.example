# PortfolioHub has no build step: the browser reads js/config.js directly.
# This file only documents which values you need. Copy them into js/config.js
# (supabaseUrl, supabaseAnonKey) or into your hosting dashboard.
#
# Use the publishable / anon key ONLY. Never put a service_role or secret key in browser code.

SUPABASE_URL=https://pxxdfbbfodslqduplcpb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ZQVHtCcjUbL_QjWjWLR6Fw_Lt5WYWUD

# ---------------------------------------------------------------------------------------------
# Contact form email delivery (api/contact.js, a Vercel serverless function).
# These are SERVER-SIDE secrets: set them in Vercel -> Project -> Settings -> Environment Variables.
# NEVER put them in js/config.js or any file served to the browser. Setup guide: docs/CONTACT_FORM_SETUP.md
#
# SUPABASE_URL and SUPABASE_ANON_KEY (above) must ALSO be set as Vercel environment variables, because the
# function uses them to look up the portfolio owner's contact email (the anon key is public by design).
# ---------------------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM=PortfolioHub <contact@your-verified-domain.com>
# Optional: extra trusted origins, comma separated (the site's own origin is always allowed)
# ALLOWED_ORIGINS=https://www.your-domain.com
